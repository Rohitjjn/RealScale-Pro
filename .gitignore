# VS Code
.vscode/

# Flutter/Dart/Pub related
# Generated by `flutter gen-l10n` (never hand-edited, never committed).
/lib/l10n/app_localizations*.dart
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication and obfuscation related
app.*.symbols
app.*.map.json

# Android Studio build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# Downloaded AI models & native prebuilts (never commit weights/binaries).
# The model registry, its checksums and the tiny test fixtures ARE committed:
# the test suite runs real inference against them in CI.
/models_cache/
/native/third_party/
/native/build*/
/test/fixtures/tmp/
/test/fixtures/out/
*.param
*.bin
!/**/assets/models_starter/**
!/test/fixtures/**
# Artifacts produced by the release workflows
/release-out/

# Local config
.env
*.local
