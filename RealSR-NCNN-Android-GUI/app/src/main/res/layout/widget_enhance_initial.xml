<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher placeholder for the "Enhance a photo" widget (what the home screen draws between adding
  the widget and the first Glance frame, and on devices where the Glance render fails). It mirrors
  the real widget instead of showing the bare app name, so the widget never looks broken.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_canvas"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/brand_logo_medallion" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/app_name"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_cta_background"
        android:gravity="center"
        android:text="@string/widget_enhance_cta"
        android:textColor="@color/widget_on_cta"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
